{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syscore-assembly",
  "compatibility_date": "2026-05-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "assembly.syscore.uk",
      "custom_domain": true,
      "zone_name": "syscore.uk"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
