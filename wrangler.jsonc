
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syscore-assembly",
  "main": "worker.js",
  "compatibility_date": "2026-05-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "assembly.syscore.uk",
      "custom_domain": true,
      "zone_name": "syscore.uk"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
